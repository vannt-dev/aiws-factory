    "claude-code",
    "orchestration",
    "software-factory",
    "human-in-the-loop",
    "traceability",
    "code-generation"
  ],
  "homepage": "https://vannt-dev.github.io/aiws-factory/",
  "bugs": {
    "url": "https://github.com/vannt-dev/aiws-factory/issues"
  },
  "repository": {
    "type": "git",
