# https://editorconfig.org
# Applies only to AIWS-owned files; source-* keep the settings of their own repositories.
root = true

[{aiws/**,.github/**,.claude/**,/*.md,/.editorconfig,/.gitattributes,/.gitignore}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[{/*.md,aiws/**.md,.github/**.md}]
trim_trailing_whitespace = false
